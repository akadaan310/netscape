+  assert.ok(!html.includes('<script>'));
+});
+test('adapter exposes typed passage action and stable semantic identity',()=>{
+  const html=renderToStaticMarkup(createElement(SurfaceRenderer,{graph,surface,palette,onAction:()=>{}}));
