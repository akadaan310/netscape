+import {readFile,writeFile,mkdir,readdir,stat} from 'node:fs/promises';
+import {execFileSync} from 'node:child_process';
+import {resolve} from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {performance} from 'node:perf_hooks';
+import os from 'node:os';
+import {FAMILIES,generateSurface,structuralSignature,GRAMMAR_VERSION,type Display,type Family,type SemanticGraph,type SurfaceNode} from '../packages/core/src/index.ts';
+import {interpretHTML} from '../packages/resource-interpreter/src/index.ts';
+import {field,gamutMap,contrast} from '../packages/chromatics/src/index.ts';
+import {createWorld,enqueueEvent,stepWorld,snapshot} from '../packages/dynamics/src/index.ts';
+import {PERFORMERS as P,compose,runPipeline,reconstructTrace,definePerformer,CAPABILITY_PACK} from '../packages/performers/src/index.ts';
+import {auditSurface,independentSignature,paretoRanks,sha256,wcagContrast} from './oracles.ts';
+import {createReplayManifest,replay,type ReplayManifest} from './replay.ts';
+
+type Result={id:string;status:'pass'|'fail'|'pending';metrics:Record<string,unknown>;failures:unknown[]};
+const root=resolve(fileURLToPath(new URL('..',import.meta.url)));
+const fixedDate='2026-10-18T00:00:00.000Z';
+const allowedActions=new Set(['open-external','select-passage','attach-companion','save-artifact','navigate']);
+function checked(condition:unknown,message:string,failures:unknown[],details?:unknown){if(!condition)failures.push({message,details});}
+function rejected(f:()=>unknown):boolean{try{f();return false;}catch{return true;}}
+async function rejects(f:()=>Promise<unknown>):Promise<boolean>{try{await f();return false;}catch{return true;}}
+
+export async function runExperiments(){
