+      const importance=degree.get(graph.nodes[i].id)!;
+      const col=importance>3?(widths[0]>=widths[1]?0:1):(ys[0]<=ys[1]?0:1);
+      const r=add(i,PAD+(col===1?widths[0]+GAP:0),ys[col],widths[col]);ys[col]+=r.height+GAP;
