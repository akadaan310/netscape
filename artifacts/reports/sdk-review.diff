+import { canonical, hash, validateGraph as coreValidateGraph } from '@netscape/core';
+import type { SemanticGraph, Intent } from '@netscape/core';
+export const VERSION = '1.0.0';
+export const CONSTITUTION_VERSION = '1.0.0';
+export type Effect = 'pure' | 'local-state' | 'external-read' | 'external-mutation';
+export interface Schema<T, ID extends string = string> {
+    readonly id: ID;
+    readonly description: string;
+    validate(value: unknown): value is T;
+}
+export interface Condition<T> {
+    readonly description: string;
+    check(value: T): boolean;
+}
+export interface RuntimeContext {
+    readonly capabilities: Readonly<Record<string, (input: unknown) => unknown | Promise<unknown>>>;
+}
+export interface Performer<I, O, InputID extends string = string, OutputID extends string = string> {
+    readonly id: string;
+    readonly version: string;
+    readonly description: string;
+    readonly input: Schema<I, InputID>;
+    readonly output: Schema<O, OutputID>;
+    readonly preconditions: readonly Condition<I>[];
+    readonly postconditions: readonly Condition<O>[];
+    readonly effects: readonly Effect[];
+    readonly requires: readonly string[];
+    readonly provides: readonly string[];
+    readonly failureModes: readonly string[];
+    readonly determinism: 'deterministic' | 'capability-dependent';
+    readonly provenance: {
+        readonly source: string;
+        readonly implementation: string;
+    };
+    readonly constitutionClauses: readonly string[];
+    execute(input: I, context: RuntimeContext): O | Promise<O>;
+}
+// Runtime composition checks schema IDs. Generic input/output types remain available on every operation.
+export type AnyPerformer = Performer<any, any>;
+export type InputOf<P> = P extends Performer<infer I, any> ? I : never;
+export type OutputOf<P> = P extends Performer<any, infer O> ? O : never;
+export interface Pipeline<I = unknown, O = unknown> {
+    readonly version: string;
+    readonly steps: readonly AnyPerformer[];
+    readonly input: Schema<I>;
+    readonly output: Schema<O>;
+}
+export interface RunOptions {
+    readonly authority?: readonly Effect[];
+    readonly capabilities?: RuntimeContext['capabilities'];
+}
+export interface TraceStep {
+    readonly performer: string;
+    readonly version: string;
+    readonly inputSchema: string;
+    readonly outputSchema: string;
+    readonly effects: readonly Effect[];
+    readonly requires: readonly string[];
+    readonly status: 'executed';
